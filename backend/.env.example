# Copy this file to .env (in the repo root, TAM/) or backend/.env.local and fill in values.
# backend/.env.local overrides the root .env — handy for toggling USE_MOCK_LLM locally
# without touching a shared .env file.

# ── Anthropic (LLM agents) ───────────────────────────────────────────────────
# USE_MOCK_LLM=true (default) runs the full pipeline with deterministic fixture
# responses — no API key required. Set to false + provide a real key to use
# the live Anthropic API for CoA mapping, QoE review, red flag enrichment,
# contract parsing, and narrative drafting.
USE_MOCK_LLM=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Storage (local POC — JSON files on disk, paths relative to launch dir) ──
DEAL_STORE_DIR=data/deals
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
USER_STORE_DIR=data/users

# ── Security (required — the app will not start without these) ──────────────
# FILE_ENCRYPTION_KEY: AES-256-GCM master key for every file this app persists
# (deal/user JSON, uploaded documents, processed pipeline output). Base64-encoded
# 32 raw bytes. Generate one with:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# This is a POC-grade key held in an env var — move it to a real KMS/Vault
# before any production use.
FILE_ENCRYPTION_KEY=
# JWT_SECRET_KEY: signs session tokens (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_EXPIRY_DAYS=7

# ── Email (password reset) ───────────────────────────────────────────────────
# SMTP_HOST unset (default) → forgot-password writes the reset link to
# data/dev_outbox/ instead of emailing it — local-dev only, see
# app/services/email.py. Set SMTP_HOST (+ the rest) to any real SMTP relay
# (SES, SendGrid, Mailgun, Postmark, Gmail, self-hosted) to send real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@tam.local
# Used to build the absolute reset link inside the email.
FRONTEND_BASE_URL=http://localhost:3000

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated list is NOT supported directly — this is a Python list field;
# override via a JSON array string if you need to change it, e.g.:
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
LOG_JSON=false
