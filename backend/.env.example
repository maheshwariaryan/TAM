# Copy this file to .env (in the repo root, TAM/) or backend/.env.local and fill in values.
# backend/.env.local overrides the root .env — handy for toggling USE_MOCK_LLM locally
# without touching a shared .env file.

# ── Anthropic (LLM agents) ───────────────────────────────────────────────────
# USE_MOCK_LLM=true (default) runs the full pipeline with deterministic fixture
# responses — no API key required. Set to false + provide a real key to use
# the live Anthropic API for CoA mapping, QoE review, red flag enrichment,
# contract parsing, and narrative drafting.
USE_MOCK_LLM=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Storage (local POC — JSON files on disk, paths relative to launch dir) ──
DEAL_STORE_DIR=data/deals
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

# ── Server ───────────────────────────────────────────────────────────────────
# Comma-separated list is NOT supported directly — this is a Python list field;
# override via a JSON array string if you need to change it, e.g.:
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOG_LEVEL=INFO
LOG_JSON=false
